{
  "manifest_version": 3,
  "name": "AI Content Vault",
  "version": "1.0.0",
  "icons": {
    "48": "icons/vault.png",
    "128": "icons/vault.png"
  },
  "description": "Save YouTube videos and Instagram posts to AI Content Vault.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://aicontentvault.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icons/vault.png",
    "default_popup": "index.html"
  }
}