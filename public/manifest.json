{
  "manifest_version": 3,
  "name": "AI Content Vault",
  "version": "1.0.0",
  "description": "Save Instagram posts and reels to AI Content Vault.",

  "permissions": [
    "storage",
    "identity"
  ],

  "host_permissions": [
    "https://www.instagram.com/*",
    "https://aicontentvault.site/*"
  ],

  "action": {
    "default_popup": "index.html"
  }
}