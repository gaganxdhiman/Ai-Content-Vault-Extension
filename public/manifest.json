{
  "manifest_version": 3,
  "name": "AI Content Saver",
  "version": "1.0.0",
  "icons": {
  "48": "favicon.png",
  "128": "favicon.png"
},
  "description": "Save YouTube videos and Instagram posts within the browser and search when needed in AI Content Vault.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://aicontentvault.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
  "default_icon": "favicon.png",
  "default_popup": "index.html"
}
}