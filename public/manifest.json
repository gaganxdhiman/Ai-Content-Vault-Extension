{
  "manifest_version": 3,
  "name": "AI Content Saver— Save Reels & Videos",
  "version": "1.0.0",
  "key": "kbioahpmnemhnehpdgfpcedllkhnjnha",
  "icons": {
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "description": "Save YouTube videos, Shorts, Instagram posts, and Reels to your AI Content Vault with optional notes.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "https://aicontentvault.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["youtube.js", "youtube-home.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "favicon.png",
    "default_popup": "index.html"
  }
}